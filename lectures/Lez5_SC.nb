Cell[CellGroupData[{

Cell["Expand & ExpandAll", "Subsection",
 CellChangeTimes->{{3.9090221868829393`*^9, 3.9090221969949827`*^9}, {
  3.909022477291108*^9, 3.9090224788305054`*^9}, {3.9090229301753445`*^9, 
  3.9090229355081196`*^9}},ExpressionUUID->"edca5354-df93-4c02-9887-\
6a6d64f61c21"],

Cell["\<\
Expressions involving polynomials can be expanded out using the \
\[OpenCurlyQuote]Expand\[CloseCurlyQuote] function:\
\>", "Text",
 CellChangeTimes->{{3.909022553782253*^9, 
  3.9090225677479267`*^9}},ExpressionUUID->"ba43ce36-874c-43c7-9999-\
830dd8dbb7b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Expand", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}], "2"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}], "2"]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", 
  RowBox[{"x", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "3"], "+", "3"}], ")"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.909022568796788*^9, 3.9090226018540163`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"f0abb20a-19dd-4f12-b818-4213604d28ed"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "4"]}]], "Output",
 CellChangeTimes->{3.910759583957162*^9, 3.9416383631352386`*^9, 
  3.941691062726211*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"1d6b9e41-6877-4844-8a4d-d0e4c813bde4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"3", " ", "x"}], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "3"]}], "+", 
  SuperscriptBox["x", "4"], "+", 
  SuperscriptBox["x", "6"]}]], "Output",
 CellChangeTimes->{3.910759583957162*^9, 3.9416383631352386`*^9, 
  3.941691062774622*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"2cfeab99-cda6-4d49-b383-9977d0e72f21"]
}, Open  ]],

Cell["\<\
\[OpenCurlyQuote]Expand\[CloseCurlyQuote] doesn\[CloseCurlyQuote]t operate \
within \[OpenCurlyDoubleQuote]subexpressions.\[CloseCurlyDoubleQuote] For \
example:\
\>", "Text",
 CellChangeTimes->{{3.9090227201406345`*^9, 
  3.9090227454921455`*^9}},ExpressionUUID->"feabfb5c-9d8a-4657-9b3c-\
bb9a554eff8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"Sqrt", "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.909022746809589*^9, 3.909022756863887*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"3f036a93-c02e-4644-acab-6b4c80e29fdb"],

Cell[BoxData[
 SqrtBox[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "+", "x"}], ")"}], "2"]]], "Output",
 CellChangeTimes->{3.910759594605081*^9, 3.941638375726552*^9, 
  3.941691079956653*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"307a77b1-02dd-4c2d-9bd2-b17b1131e1b7"]
}, Open  ]],

Cell["\<\
To expand the polynomial inside of the square root, use \
\[OpenCurlyQuote]ExpandAll\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.909022767156041*^9, 
  3.909022780907466*^9}},ExpressionUUID->"6e43ffc4-5c1f-4bc1-a669-\
61491d872de0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExpandAll", "[", 
  RowBox[{"Sqrt", "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9090227824523964`*^9, 3.9090227871094313`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"9d9676ea-f9e8-45c1-8fc4-68992a287999"],

Cell[BoxData[
 SqrtBox[
  RowBox[{"1", "+", 
   RowBox[{"2", " ", "x"}], "+", 
   SuperscriptBox["x", "2"]}]]], "Output",
 CellChangeTimes->{3.910759600985723*^9, 3.94163837720112*^9, 
  3.941691081961275*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"c591463e-b059-45a9-a04b-3393f75a88ab"]
}, Open  ]],

Cell["\<\
Similarly, \[OpenCurlyQuote]Expand\[CloseCurlyQuote] only expands the \
numerator of expressions:\
\>", "Text",
 CellChangeTimes->{{3.9090227968139753`*^9, 
  3.9090228095969796`*^9}},ExpressionUUID->"d6f027af-1b4e-46fc-9073-\
731301e8de2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  FractionBox[
   RowBox[{
    RowBox[{"x", " ", "y"}], "+", 
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", 
     SuperscriptBox["z", "4"]}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"y", "+", "z"}], ")"}], "4"]], "]"}]], "Input",
 CellChangeTimes->{{3.9090228129471765`*^9, 3.909022835001423*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"e2557c0d-5f38-4eba-b7d4-4d6979bcb5af"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   SuperscriptBox["x", "2"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"y", "+", "z"}], ")"}], "4"]], "+", 
  FractionBox[
   RowBox[{"x", " ", "y"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"y", "+", "z"}], ")"}], "4"]], "+", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["z", "4"]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"y", "+", "z"}], ")"}], "4"]]}]], "Output",
 CellChangeTimes->{3.9107596072803307`*^9, 3.941638382282228*^9, 
  3.941691088058012*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"33a2c4b7-1585-4c0b-b62b-cc83c1f088f2"]
}, Open  ]],

Cell["Use \[OpenCurlyQuote]ExpandAll\[CloseCurlyQuote] to expand both \
numerator and denominator:", "Text",
 CellChangeTimes->{{3.9090228437840633`*^9, 
  3.9090228647880535`*^9}},ExpressionUUID->"a5c24658-b6c5-4a94-b4e5-\
77f119b955c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExpandAll", "[", 
  FractionBox[
   RowBox[{
    RowBox[{"x", " ", "y"}], "+", 
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", 
     SuperscriptBox["z", "4"]}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"y", "+", "z"}], ")"}], "4"]], "]"}]], "Input",
 CellChangeTimes->{{3.909022866006922*^9, 3.9090228910093217`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"1f0ce453-07a3-4d12-86e0-2f02cb99950c"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   SuperscriptBox["x", "2"], 
   RowBox[{
    SuperscriptBox["y", "4"], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["y", "3"], " ", "z"}], "+", 
    RowBox[{"6", " ", 
     SuperscriptBox["y", "2"], " ", 
     SuperscriptBox["z", "2"]}], "+", 
    RowBox[{"4", " ", "y", " ", 
     SuperscriptBox["z", "3"]}], "+", 
    SuperscriptBox["z", "4"]}]], "+", 
  FractionBox[
   RowBox[{"x", " ", "y"}], 
   RowBox[{
    SuperscriptBox["y", "4"], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["y", "3"], " ", "z"}], "+", 
    RowBox[{"6", " ", 
     SuperscriptBox["y", "2"], " ", 
     SuperscriptBox["z", "2"]}], "+", 
    RowBox[{"4", " ", "y", " ", 
     SuperscriptBox["z", "3"]}], "+", 
    SuperscriptBox["z", "4"]}]], "+", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["z", "4"]}], 
   RowBox[{
    SuperscriptBox["y", "4"], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["y", "3"], " ", "z"}], "+", 
    RowBox[{"6", " ", 
     SuperscriptBox["y", "2"], " ", 
     SuperscriptBox["z", "2"]}], "+", 
    RowBox[{"4", " ", "y", " ", 
     SuperscriptBox["z", "3"]}], "+", 
    SuperscriptBox["z", "4"]}]]}]], "Output",
 CellChangeTimes->{3.91075961437639*^9, 3.941638384406887*^9, 
  3.941691092440884*^9},
 CellLabel->
  "Out[121]=",ExpressionUUID->"b1b22372-612c-4206-a4b4-65e1f389bfbb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["PowerExpand & ComplexExpand", "Subsection",
 CellChangeTimes->{{3.909022946553402*^9, 3.9090229478166184`*^9}, {
  3.909023017655789*^9, 
  3.909023022095823*^9}},ExpressionUUID->"aab2af35-082f-4679-9c73-\
2e6c084948bf"],

Cell["To expand powers in expressions, use \[OpenCurlyQuote]PowerExpand\
\[CloseCurlyQuote]:", "Text",
 CellChangeTimes->{{3.9090229606821823`*^9, 
  3.909022970326852*^9}},ExpressionUUID->"75451511-e677-442d-bb0e-\
6422206f19a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"PowerExpand", "[", 
  RowBox[{"Sqrt", "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"PowerExpand", "[", 
  RowBox[{"Sqrt", "[", 
   SuperscriptBox["x", "2"], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"PowerExpand", "[", 
  RowBox[{"Sqrt", "[", 
   RowBox[{"x", " ", "y"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"PowerExpand", "[", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "x"}], ")"}], 
   RowBox[{"1", "/", "3"}]], "]"}]}], "Input",
 CellChangeTimes->{{3.9090229715424337`*^9, 3.909022989311142*^9}, {
  3.909023128075142*^9, 3.9090231490927424`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"5f71f1e7-770a-4e4f-b241-5f7ef9da679f"],

Cell[BoxData[
 RowBox[{"1", "+", "x"}]], "Output",
 CellChangeTimes->{3.9107596370196877`*^9, 3.941638389891325*^9, 
  3.941691118378154*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"92d74c3e-417d-405d-a790-c507ae15c49b"],

Cell[BoxData["x"], "Output",
 CellChangeTimes->{3.9107596370196877`*^9, 3.941638389891325*^9, 
  3.9416911184451427`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"e44ebc84-8625-423d-a5ea-3e3c8045a961"],

Cell[BoxData[
 RowBox[{
  SqrtBox["x"], " ", 
  SqrtBox["y"]}]], "Output",
 CellChangeTimes->{3.9107596370196877`*^9, 3.941638389891325*^9, 
  3.941691118485772*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"b2d79615-69e7-4b97-aadc-0be7c3b71753"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], 
   RowBox[{"1", "/", "3"}]], " ", 
  SuperscriptBox["x", 
   RowBox[{"1", "/", "3"}]]}]], "Output",
 CellChangeTimes->{3.9107596370196877`*^9, 3.941638389891325*^9, 
  3.941691118527294*^9},
 CellLabel->
  "Out[125]=",ExpressionUUID->"68b48672-1329-4816-9307-2c850ce33153"]
}, Open  ]],

Cell["\<\
Notice that with \[OpenCurlyQuote]PowerExpand\[CloseCurlyQuote], we don\
\[CloseCurlyQuote]t need assumptions like we did with \
\[OpenCurlyQuote]Simplify\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.9090231861471643`*^9, 3.9090232053961363`*^9}, {
  3.941638408521081*^9, 
  3.941638409194365*^9}},ExpressionUUID->"bb457d7c-aa68-4369-b6e2-\
4af0de194554"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    SuperscriptBox["x", "2"], "]"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{"x", ">", "0"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"PowerExpand", "@", 
  RowBox[{"Sqrt", "[", 
   SuperscriptBox["x", "2"], "]"}]}]}], "Input",
 CellChangeTimes->{{3.909023207738537*^9, 3.9090232227984185`*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"e8b82fb7-9039-4538-8eb4-17f9f3e37eb5"],

Cell[BoxData["x"], "Output",
 CellChangeTimes->{3.91075965533465*^9, 3.9416384101876783`*^9, 
  3.941691133748961*^9},
 CellLabel->
  "Out[126]=",ExpressionUUID->"b155bcaa-6db4-41cb-a0c0-10fc86e9ec9c"],

Cell[BoxData["x"], "Output",
 CellChangeTimes->{3.91075965533465*^9, 3.9416384101876783`*^9, 
  3.94169113381314*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"346de699-83f4-4df0-9431-a601890aec90"]
}, Open  ]],

Cell["\<\
We can also expand assuming that all variables/expressions are complex using \
\[OpenCurlyQuote]ComplexExpand\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.9090233353353357`*^9, 3.9090233525996256`*^9}, {
  3.9090234062613792`*^9, 
  3.909023407870267*^9}},ExpressionUUID->"021e5498-7608-4760-8154-\
fdc9285b8218"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ComplexExpand", "[", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], 
   RowBox[{"1", "/", "3"}]], "]"}]], "Input",
 CellChangeTimes->{{3.9090233538922496`*^9, 3.9090233976109467`*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"e7295f4f-0475-4f29-84ec-06177cfc5310"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], "+", 
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SqrtBox["3"]}], "2"]}]], "Output",
 CellChangeTimes->{3.910759667858038*^9, 3.9416384149588614`*^9, 
  3.9416911399243383`*^9},
 CellLabel->
  "Out[128]=",ExpressionUUID->"3b81fc8c-8f01-44bc-9139-230e6c0a0cd2"]
}, Open  ]],

Cell["\<\
Note that to input the imaginary unit, you can either type capital \
\[OpenCurlyQuote]I\[CloseCurlyQuote] or \[OpenCurlyQuote]Esc + ii + Esc\
\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.909023443433584*^9, 
  3.909023467732938*^9}},ExpressionUUID->"5897f7f8-72c9-4bc4-aa5d-\
ecd06b3a3005"],

Cell[CellGroupData[{

Cell[BoxData["I"], "Input",
 CellChangeTimes->{{3.910411066528582*^9, 3.9104110678276463`*^9}, {
  3.9416911571723747`*^9, 3.941691158725876*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"fd3834b1-9435-4684-b427-e1e0be1fe658"],

Cell[BoxData["\[ImaginaryI]"], "Output",
 CellChangeTimes->{3.9107597524876823`*^9, 3.941638420536268*^9, 
  3.941691159011918*^9},
 CellLabel->
  "Out[130]=",ExpressionUUID->"8c6aa773-450b-4979-9fcf-248b4300c773"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["\[ImaginaryI]"], "Input",
 CellChangeTimes->{{3.910411069465716*^9, 3.910411070738468*^9}, {
  3.910759748515398*^9, 3.910759750455892*^9}, {3.9416911529189177`*^9, 
  3.9416911547585783`*^9}},
 CellLabel->
  "In[129]:=",ExpressionUUID->"c65b2a5b-5266-4650-a62e-a61ef25679f0"],

Cell[BoxData["\[ImaginaryI]"], "Output",
 CellChangeTimes->{3.9107597531360407`*^9, 3.941638421664053*^9, 
  3.941691155931383*^9},
 CellLabel->
  "Out[129]=",ExpressionUUID->"19678d2c-cffa-42a7-8f98-5de62201d458"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ComplexExpand", "[", 
   RowBox[{"Sin", "[", 
    RowBox[{"x", "+", 
     RowBox[{"I", " ", "y"}]}], "]"}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "expansion", " ", "the", " ", "the", " ", "sin", " ", "of", " ", "this", " ",
     "complex", " ", "number"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ComplexExpand", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"x", "+", 
    RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.909023410550934*^9, 3.909023434798482*^9}, {
  3.90902347109091*^9, 3.9090234767307587`*^9}, {3.9104110484475484`*^9, 
  3.910411075708556*^9}, {3.9729677850477858`*^9, 3.9729678003434353`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"dd1e42a7-98a2-4679-9ff6-ce5d8435fcaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cosh", "[", "y", "]"}], " ", 
   RowBox[{"Sin", "[", "x", "]"}]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   RowBox[{"Sinh", "[", "y", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9107597584627934`*^9, 3.941638423716692*^9, 
  3.9416911621492968`*^9, 3.972967770007224*^9, 3.972967800954199*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"ada1e62d-4416-44d8-8001-be59aa1f1dbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cosh", "[", "y", "]"}], " ", 
   RowBox[{"Sin", "[", "x", "]"}]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   RowBox[{"Sinh", "[", "y", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9107597584627934`*^9, 3.941638423716692*^9, 
  3.9416911621492968`*^9, 3.972967770007224*^9, 3.972967800956744*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"fbdaa70e-6e8c-4e00-b346-86bce995fcbd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Factoring Polynomials", "Subsection",
 CellChangeTimes->{{3.909034590599846*^9, 
  3.9090345939647713`*^9}},ExpressionUUID->"04123cf1-1517-42cc-aa82-\
8be6b42c62bd"],

Cell["Polynomials can be factored using the \[OpenCurlyQuote]Factor\
\[CloseCurlyQuote] function:", "Text",
 CellChangeTimes->{{3.9090346028753557`*^9, 
  3.9090346121907945`*^9}},ExpressionUUID->"51b0acce-eb47-45ec-8128-\
cdb62e673b55"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Factor", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], "-", 
    SuperscriptBox["y", "2"]}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "bascally", " ", "is", " ", "the", " ", "polynomial", " ", "division"}], ",",
     " ", 
    RowBox[{"but", " ", "done", " ", "automatically"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Factor", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], "-", 
   RowBox[{"2", "x"}], "+", "1"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Factor", "[", 
  RowBox[{
   SuperscriptBox["x", "10"], "-", "1"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9090346132051897`*^9, 3.909034653063635*^9}, {
  3.972967814613983*^9, 3.9729678329005527`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"5a70e785-aa18-47a6-8d5f-73341513e889"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"x", "-", "y"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"x", "+", "y"}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.91075977273814*^9, 3.941638428898625*^9, 3.941691173535592*^9, {
   3.972967779168767*^9, 3.9729678333972893`*^9}},
 CellLabel->"Out[11]=",ExpressionUUID->"e83f7d77-1264-4c63-a366-a9382e9cccdf"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "x"}], ")"}], "2"]], "Output",
 CellChangeTimes->{
  3.91075977273814*^9, 3.941638428898625*^9, 3.941691173535592*^9, {
   3.972967779168767*^9, 3.9729678333997383`*^9}},
 CellLabel->"Out[12]=",ExpressionUUID->"d58d4e49-e9b1-40c3-8c85-7154f7d4cd7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "x"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"1", "-", "x", "+", 
    SuperscriptBox["x", "2"], "-", 
    SuperscriptBox["x", "3"], "+", 
    SuperscriptBox["x", "4"]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "x", "+", 
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["x", "3"], "+", 
    SuperscriptBox["x", "4"]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.91075977273814*^9, 3.941638428898625*^9, 3.941691173535592*^9, {
   3.972967779168767*^9, 3.972967833402114*^9}},
 CellLabel->"Out[13]=",ExpressionUUID->"cf769f51-0836-4c2d-994a-8ec0ca0e8a05"]
}, Open  ]],

Cell[BoxData["  "], "Input",
 CellChangeTimes->{{3.972967812447781*^9, 
  3.9729678126635036`*^9}},ExpressionUUID->"cdd60e77-0ae4-4b4a-b40b-\
c3a9318e82c6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Manipulating Trig Expressions", "Subsection",
 CellChangeTimes->{{3.9090293280386353`*^9, 
  3.909029333682689*^9}},ExpressionUUID->"126de646-a208-4912-9e34-\
435dcce9297b"],

Cell["\<\
Not all trig expressions can be simplified/manipulated with \
\[OpenCurlyQuote]Simplify\[CloseCurlyQuote] and \[OpenCurlyQuote]Expand\
\[CloseCurlyQuote].\
\>", "Text",
 CellChangeTimes->{{3.909034211377294*^9, 
  3.909034233504562*^9}},ExpressionUUID->"d06d458f-63d8-43e0-a95c-\
bd416ea64ead"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"Cos", "[", "x", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", 
  RowBox[{"Cos", "[", 
   RowBox[{"3", "x"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.909034236103652*^9, 3.9090342884286633`*^9}, {
  3.909034349280944*^9, 3.9090343577526827`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"29b7ee02-9cb8-4b2b-89e6-4be75cfb1670"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cos", "[", "x", "]"}], " ", 
  RowBox[{"Sin", "[", "x", "]"}]}]], "Output",
 CellChangeTimes->{3.910759795401949*^9, 3.941638435242774*^9, 
  3.9416912011781197`*^9, 3.972967837898777*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"11776656-16d6-4e12-bc24-11875e48294b"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"Sin", "[", "x", "]"}], "2"]], "Output",
