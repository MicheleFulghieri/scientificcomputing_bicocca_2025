Cell["\<\
The function for performing analytic integration in Mathematica is \
\[OpenCurlyDoubleQuote]Integrate\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.9101686791338673`*^9, 
  3.9101687015728836`*^9}},ExpressionUUID->"ce48e8f2-ee77-4f58-adda-\
cf17423393c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.91016870261304*^9, 3.9101687064002113`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"a50a86a0-0c5f-4cf8-86b4-d1f527d68052"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["x", "3"], "3"]], "Output",
 CellChangeTimes->{3.910760997396598*^9, 3.9416386992815733`*^9, 
  3.941692006177083*^9, 3.972968463164268*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"17be31ad-68aa-47eb-a64d-4428bc91e6c7"]
}, Open  ]],

Cell["\<\
The above input/output shows an example of indefinite integration. \
\[OpenCurlyDoubleQuote]Integrate\[CloseCurlyDoubleQuote] has similar input \
structure to \[OpenCurlyDoubleQuote]D\[CloseCurlyDoubleQuote]:
D[func_, {vars_, n}]
Integrate[func_, {vars_, a, b}]
There are two differences though. The first is when specifying repeated \
integration. The following doesn\[CloseCurlyQuote]t work\
\>", "Text",
 CellChangeTimes->{{3.9101687204635515`*^9, 
  3.9101688402013245`*^9}},ExpressionUUID->"67702321-77df-4e90-99fb-\
45b17ce3df73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.910168796226053*^9, 3.910168804426577*^9}, {
  3.9107610163370543`*^9, 3.910761017144618*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"a124691f-461b-4c69-8fdb-fd92f9129cea"],

Cell[BoxData[
 TemplateBox[{
  "Integrate", "ilim", 
   "\"Invalid integration variable or limit(s) in \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{\\\"x\\\", \\\",\\\", \\\"2\\\"}], \\\"}\\\"}]\\).\"", 2, 91, 2, 
   18036799314640540459, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.910761017859832*^9, 3.941638705294228*^9, 
  3.941692022535718*^9, 3.9729684878279467`*^9},
 CellLabel->
  "During evaluation of \
In[91]:=",ExpressionUUID->"8c119fb0-3bf3-42b0-8b64-04dc49ad6a7d"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "2"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.910761017889906*^9, 3.941638705336568*^9, 
  3.941692022572747*^9, 3.972968487841591*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"7d692be4-6bb8-4347-b69a-75b308754a6e"]
}, Open  ]],

Cell["... but the following does!", "Text",
