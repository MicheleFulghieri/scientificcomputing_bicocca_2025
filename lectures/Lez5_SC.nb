  RowBox[{"2", " ", "y"}], "+", 
  SuperscriptBox["y", "2"]}]], "Output",
 CellChangeTimes->{3.9107587048628902`*^9, 3.941638027295816*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"18c421ac-d479-401d-810c-c4c3323af707"]
}, Open  ]],

