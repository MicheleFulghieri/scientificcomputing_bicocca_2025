Cell["A few more examples:", "Text",
 CellChangeTimes->{{3.9101684978396673`*^9, 
  3.910168500991028*^9}},ExpressionUUID->"e8b4b386-0585-45b6-90cf-\
93455a36b59f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "f", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "g", "]"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   SuperscriptBox["x", "n"], ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"f", "[", "x", "]"}], "n"], ",", "x"}], "]"}], "f_integr"}], 
  " ", "=", " ", "\[IndentingNewLine]", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], 
     RowBox[{"g", "[", "x", "]"}]}], ",", "x"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "/", 
    RowBox[{"g", "[", "x", "]"}]}], ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"f", "[", "x", "]"}]}], "+", 
    RowBox[{"b", " ", 
     RowBox[{"g", "[", "x", "]"}]}]}], ",", "x"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9101685019603925`*^9, 3.9101685429946012`*^9}, {
   3.9104120545588236`*^9, 3.910412060625326*^9}, 
   3.972971733827429*^9},ExpressionUUID->"1e49fc10-b782-4f91-9c2d-\
97b408f97087"],

Cell[BoxData[
 RowBox[{"n", " ", 
  SuperscriptBox["x", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "n"}]]}]], "Output",
 CellChangeTimes->{3.9107609123302603`*^9, 3.941638677045896*^9, 
  3.941691936764629*^9, 3.972968440783526*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"d63a7330-bb19-42de-824d-1c843244c85a"],

Cell[BoxData[
 RowBox[{"n", " ", 
  SuperscriptBox[
   RowBox[{"f", "[", "x", "]"}], 
   RowBox[{
    RowBox[{"-", "1"}], "+", "n"}]], " ", 
  RowBox[{
   SuperscriptBox["f", "\[Prime]",
    MultilineFunction->None], "[", "x", "]"}]}]], "Output",
 CellChangeTimes->{3.9107609123302603`*^9, 3.941638677045896*^9, 
  3.941691936764629*^9, 3.972968440787279*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"8a2ca778-bfd3-45e3-a78c-dfc6e646f825"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["g", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9107609123302603`*^9, 3.941638677045896*^9, 
  3.941691936764629*^9, 3.972968440790392*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"8551e5e9-e328-450c-ba9e-d5ca7f0c791b"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}], 
   RowBox[{"g", "[", "x", "]"}]], "-", 
  FractionBox[
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], " ", 
    RowBox[{
     SuperscriptBox["g", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}]}], 
   SuperscriptBox[
    RowBox[{"g", "[", "x", "]"}], "2"]]}]], "Output",
