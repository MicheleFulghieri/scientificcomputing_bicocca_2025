  3.909020179924365*^9}},ExpressionUUID->"8969233f-46e3-47d7-af4b-\
d3b3bdd9bf1c"],

Cell["\<\
The simplest built-in function for simplification is \
\[OpenCurlyQuote]Simplify\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.90902018983179*^9, 
  3.9090202047918024`*^9}},ExpressionUUID->"94234519-b697-430f-8057-\
7b513ee5439a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], "-", 
    RowBox[{"2", "x"}], "+", "1"}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "try", " ", "to", " ", "compactify", " ", "the", " ", "expression", " ", 
    "as", " ", "much", " ", "as", " ", "possible"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.909020205969873*^9, 3.9090202126922617`*^9}, {
  3.972967227598495*^9, 3.9729672442992277`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"77f07113-586d-4228-a853-e38e419dc533"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "x"}], ")"}], "2"]], "Output",
 CellChangeTimes->{3.910759190438311*^9, 3.941638111803197*^9, 
  3.941690696420704*^9, 3.9729672107838078`*^9, 3.972967245182207*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"dc645168-1b68-4c7b-978e-ee23e3d9ae12"]
}, Open  ]],

Cell["\<\
Another example, using trig functions and the \[OpenCurlyQuote]%\
\[CloseCurlyQuote] symbol. \[OpenCurlyQuote]%\[CloseCurlyQuote] tells \
Mathematica to take the output of the previous input and do something to it:\
\>", "Text",
 CellChangeTimes->{{3.9090203249200363`*^9, 
  3.9090203704771304`*^9}},ExpressionUUID->"c0404461-5a6b-403b-bdc9-\
3c5cffd20df3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], "+", 
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "2"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", "%", "]"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "here", " ", "%", " ", "takes", " ", "the", " ", "output", " ", "of", " ", 
    "the", " ", "previous", " ", "expression", " ", "as", " ", "an", " ", 
    "input"}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9090202574442687`*^9, 3.9090203186459627`*^9}, {
  3.9416907436196527`*^9, 3.94169074601306*^9}, {3.97296725136611*^9, 
  3.9729672710909967`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"cf0943c9-7a29-4c78-acd6-53618672829f"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "2"], "+", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"]}]], "Output",
 CellChangeTimes->{{3.910759202443975*^9, 3.910759222543841*^9}, 
   3.9416381195436068`*^9, {3.941690724010661*^9, 3.941690746972563*^9}, 
   3.972967271738269*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"76e7391a-0be5-487c-b16f-0c5c03f770aa"],

Cell[BoxData["1"], "Output",
