}, Open  ]],

Cell["\<\
Mathematic doesn\[CloseCurlyQuote]t give a decimal answer for it. This is \
because Mathematica can treat numbers with arbitrary floating point \
precision. To evaluate the fraction (or any number for that matter) to a \
decimal, use the \[OpenCurlyQuote]N\[CloseCurlyQuote] function.\
\>", "Text",
 CellChangeTimes->{{3.9089622322566338`*^9, 
  3.908962288618215*^9}},ExpressionUUID->"048b1c99-6062-45c0-895e-\
7069950eafe9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"N", "[", 
  RowBox[{"2", "/", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"N", "@", 
  RowBox[{"(", 
   RowBox[{"2", "/", "3"}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"2", "/", "3"}], "//", "N"}]}], "Input",
 CellChangeTimes->{{3.90896229010032*^9, 3.90896231111027*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"87c2d059-16af-48a3-8d5e-de0a414e49f6"],

Cell[BoxData["0.6666666666666666`"], "Output",
 CellChangeTimes->{3.910758845749957*^9, 3.9416380838661013`*^9, 
  3.941690602989073*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"371e966a-8c6f-4b9c-8f87-688c2efe2711"],

Cell[BoxData["0.6666666666666666`"], "Output",
 CellChangeTimes->{3.910758845749957*^9, 3.9416380838661013`*^9, 
  3.941690603040236*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"5bd35363-90f7-4ad2-9a13-231f5310d50e"],

Cell[BoxData["0.6666666666666666`"], "Output",
 CellChangeTimes->{3.910758845749957*^9, 3.9416380838661013`*^9, 
  3.941690603086892*^9},
 CellLabel->"Out[72]=",ExpressionUUID->"b9e8d37b-2003-4372-926a-f8bb5db9357b"]
}, Open  ]],

Cell["\<\
Note that the output only has a finite number of decimal points. You can \
change this by specify an additional option of \[OpenCurlyQuote]N\
\[CloseCurlyQuote]:\
\>", "Text",
 CellChangeTimes->{{3.908962367334116*^9, 
  3.9089624002814913`*^9}},ExpressionUUID->"f74afdd8-f342-48b9-b6c7-\
268916ad2019"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"2", "/", "3"}], ",", "15"}], "]"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "specifing", " ", "the", " ", "number", " ", "of", " ", "digits", " ", "I",
     " ", "want"}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.9089624013652816`*^9, 3.9089624032461586`*^9}, {
  3.9729671542250957`*^9, 
  3.972967169815056*^9}},ExpressionUUID->"a2ca0475-7db2-4a1d-aa8e-\
37cc212fce30"],

Cell[BoxData["0.66666666666666666666666666666666666667`15."], "Output",
 CellChangeTimes->{3.910758870379015*^9, 3.9416380900819798`*^9, 
  3.941690614046464*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"f493173b-4286-45b0-a756-a5555ec3d9a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"2", "/", "3"}], ",", "100"}], "]"}]], "Input",
 CellChangeTimes->{{3.9089624149329433`*^9, 3.9089624164058104`*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"397acd58-3be0-4cae-98c0-b969db7691d4"],

Cell[BoxData["0.\
666666666666666666666666666666666666666666666666666666666666666666666666666666\
6666666666666666666666666666666666667`100."], "Output",
