  3.9416912011781197`*^9, 3.97296783790123*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"d22a9515-40dc-412c-82ac-15743ed347bb"],

Cell[BoxData[
 RowBox[{"Cos", "[", 
  RowBox[{"3", " ", "x"}], "]"}]], "Output",
 CellChangeTimes->{3.910759795401949*^9, 3.941638435242774*^9, 
  3.9416912011781197`*^9, 3.972967837903514*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"e6c6fa72-5a37-4c56-9853-ca36ed2ae682"]
}, Open  ]],

Cell["For these, use \[OpenCurlyQuote]TrigReduce\[CloseCurlyQuote] and \
\[OpenCurlyQuote]TrigExpand\[CloseCurlyQuote]:", "Text",
 CellChangeTimes->{{3.9090343091742997`*^9, 
  3.9090343262596626`*^9}},ExpressionUUID->"e9b7d17d-1dfe-4eae-b75f-\
ecc8e11e075e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TrigReduce", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"Cos", "[", "x", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TrigReduce", "[", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "x", "]"}], "2"], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrigExpand", "[", 
   RowBox[{"Cos", "[", 
    RowBox[{"3", "x"}], "]"}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"expands", " ", "in", " ", "power", " ", "of", " ", "cosx"}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9090343276209183`*^9, 3.9090343659437785`*^9}, {
  3.972967853801504*^9, 3.97296786726583*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"e2facdbf-0a8f-4838-8822-4849d235ad50"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"Sin", "[", 
   RowBox[{"2", " ", "x"}], "]"}]}]], "Output",
 CellChangeTimes->{
  3.9107598094422693`*^9, 3.9416384372665453`*^9, 3.941691228495146*^9, {
   3.972967842737033*^9, 3.9729678678209047`*^9}},
 CellLabel->"Out[20]=",ExpressionUUID->"88865598-e89d-4c9a-9400-59d3f17f149d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "-", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", "x"}], "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.9107598094422693`*^9, 3.9416384372665453`*^9, 3.941691228495146*^9, {
   3.972967842737033*^9, 3.9729678678234377`*^9}},
 CellLabel->"Out[21]=",ExpressionUUID->"a84d478c-e7df-43e9-829b-dc789a5cc87f"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"Cos", "[", "x", "]"}], "3"], "-", 
  RowBox[{"3", " ", 
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "2"]}]}]], "Output",
 CellChangeTimes->{
  3.9107598094422693`*^9, 3.9416384372665453`*^9, 3.941691228495146*^9, {
   3.972967842737033*^9, 3.9729678678259907`*^9}},
 CellLabel->"Out[22]=",ExpressionUUID->"c3448311-1db0-48a0-a67e-fbbc38210d80"]
}, Open  ]],

Cell["\<\
Generically, \[OpenCurlyQuote]TrigExpand\[CloseCurlyQuote] takes functions of \
the form cos(n*x) or sin(n*x), and transforms them to forms contain \
[cos(x)]^n and [sin(x)]^n. \[OpenCurlyQuote]TrigReduce\[CloseCurlyQuote] does \
the reverse of this.\
\>", "Text",
 CellChangeTimes->{{3.909034387202052*^9, 
  3.9090344425537205`*^9}},ExpressionUUID->"7fb7eb30-7ffc-4dc5-94d4-\
eff5c606e2fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TrigExpand", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"4", "x"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TrigReduce", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9090344436467304`*^9, 3.909034456718537*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"d5fa33c8-5ee3-4d02-86a1-b3c16ec146be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"4", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "x", "]"}], "3"], " ", 
   RowBox[{"Sin", "[", "x", "]"}]}], "-", 
  RowBox[{"4", " ", 
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "x", "]"}], "3"]}]}]], "Output",
 CellChangeTimes->{3.910759850337932*^9, 3.9416384474194603`*^9, 
  3.941691267221867*^9, 3.972967873247128*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"2758a0f5-3b9f-403d-83d0-afc3c274ec6a"],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"4", " ", "x"}], "]"}]], "Output",
 CellChangeTimes->{3.910759850337932*^9, 3.9416384474194603`*^9, 
  3.941691267221867*^9, 3.9729678732497797`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"4ac79d9c-966a-4740-9c2b-c6cb3ac324bb"]
}, Open  ]],

Cell["\<\
Trig functions can also be converted to complex exponentials and vice versa, \
using \[OpenCurlyQuote]TrigToExp\[CloseCurlyQuote] and \
\[OpenCurlyQuote]ExpToTrig\[CloseCurlyQuote].\
\>", "Text",
 CellChangeTimes->{{3.9090344805465574`*^9, 
  3.90903451779733*^9}},ExpressionUUID->"1a4d9d0a-b35c-4f76-861a-\
86786de752d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TrigToExp", "[", 
  RowBox[{"Cos", "[", 
   RowBox[{"3", "x"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ExpToTrig", "[", 
  RowBox[{"Exp", "[", 
   RowBox[{"\[ImaginaryI]", " ", "x"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9090345194246197`*^9, 3.909034536747385*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"89d597e7-63b5-4bfb-905f-a375f41e31cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "3"}], " ", "\[ImaginaryI]", " ", "x"}]]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"3", " ", "\[ImaginaryI]", " ", "x"}]]}]}]], "Output",
 CellChangeTimes->{3.910759860452224*^9, 3.941638457479348*^9, 
  3.941691275887723*^9, 3.9729678785098743`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"63f25323-9f06-4500-93ad-907383a8a899"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cos", "[", "x", "]"}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"Sin", "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{3.910759860452224*^9, 3.941638457479348*^9, 
  3.941691275887723*^9, 3.9729678785178347`*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"7137e82d-1407-442d-86dd-bcf6d5cb3ea5"]
}, Open  ]]
}, Open  ]],

