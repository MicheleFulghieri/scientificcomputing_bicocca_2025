Cell[CellGroupData[{

Cell["Calculus", "Section",
 CellChangeTimes->{{3.908957640657612*^9, 
  3.908957642102926*^9}},ExpressionUUID->"cc913d2b-3779-4b4c-8a20-\
3338b1570e50"],

Cell[CellGroupData[{

Cell["Differentiation", "Subsection",
 CellChangeTimes->{{3.9101675864327054`*^9, 
  3.910167593281272*^9}},ExpressionUUID->"6a6c74d7-fead-48c6-bb16-\
4b841a63131c"],

Cell["\<\
As mentioned at the beginning of this notebook, \[OpenCurlyDoubleQuote]D\
\[CloseCurlyDoubleQuote] corresponds to the built-in derivative functions \
within Mathematica.\
\>", "Text",
 CellChangeTimes->{{3.9101676122535763`*^9, 
  3.9101676434464293`*^9}},ExpressionUUID->"6afc0794-115a-41bd-8812-\
15c654936322"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.910167644714115*^9, 3.9101676496441193`*^9}, {
  3.910760812270439*^9, 3.910760813164936*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"16be811f-60d7-45be-8486-ca27bbb44ef9"],

Cell[BoxData[
 RowBox[{"2", " ", "x"}]], "Output",
 CellChangeTimes->{3.9107608159974813`*^9, 3.9416386410238543`*^9, 
  3.941691887328364*^9, 3.972968379160953*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"d76345f8-3bf4-4a2c-a604-25d8be8d1037"]
}, Open  ]],

Cell["\<\
The function takes inputs in the form D[func_, vars_], the first of which is \
the function to differentiate and the second is the variable to differentiate \
with respect to. So this allows a very easy extension to multiple variables:\
\>", "Text",
 CellChangeTimes->{{3.910167667962637*^9, 
  3.9101677234845886`*^9}},ExpressionUUID->"a4ca403a-86f3-47c1-8eeb-\
63a4f8d7cfb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"x", " ", "y"}], ",", "y"}], "]"}]], "Input",
 CellChangeTimes->{{3.9101677249060593`*^9, 3.9101677278174553`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"ef18c180-3b48-4efc-b3fb-8698a4055ca8"],

Cell[BoxData["x"], "Output",
 CellChangeTimes->{3.910760826324334*^9, 3.9416386461712093`*^9, 
  3.9416919038980083`*^9, 3.972968382896304*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"e33869eb-3e81-42ef-9768-a9a5ffbc94ba"]
}, Open  ]],

Cell["\<\
What if you want to take the second derivative? You might be tempted to do:\
\>", "Text",
 CellChangeTimes->{{3.910168159715309*^9, 3.9101681710678625`*^9}, {
  3.9103366907225018`*^9, 
  3.9103366913557425`*^9}},ExpressionUUID->"762caea4-4916-48c9-9b9b-\
5c6c3584aeaa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     SuperscriptBox["x", "2"], ",", "x"}], "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.9101681721630497`*^9, 3.910168176551113*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"79860b8d-3dd8-4d03-9c3a-74bb99e45f67"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.91076083861018*^9, 3.941638648871043*^9, 
  3.941691910615018*^9, 3.972968388887787*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"dc6ae2f7-1567-48a6-adc3-9fd54f638f06"]
}, Open  ]],

Cell["BUT, you don\[CloseCurlyQuote]t need to do this! The following also \
works:", "Text",
 CellChangeTimes->{{3.9101681855076504`*^9, 
  3.910168202314579*^9}},ExpressionUUID->"a93f302f-2e83-445a-8899-\
d5ad5d855a06"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], ",", "x", ",", "x"}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"equivalent", " ", "notations"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"x", " ", "y"}], ",", "x", ",", "y"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9101682035198655`*^9, 3.9101682237227483`*^9}, {
  3.972968403492859*^9, 3.972968416849305*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"5becedcb-8e15-45ad-bcc8-554d08e5558e"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{
  3.9107608655809307`*^9, 3.941638653949205*^9, 3.9416919129971457`*^9, {
   3.97296839215971*^9, 3.972968417820016*^9}},
 CellLabel->"Out[75]=",ExpressionUUID->"04aedc82-b384-4e6c-b04a-e6f1fa240a89"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{
  3.9107608655809307`*^9, 3.941638653949205*^9, 3.9416919129971457`*^9, {
   3.97296839215971*^9, 3.97296841782285*^9}},
 CellLabel->"Out[76]=",ExpressionUUID->"bae0c662-a12a-49bc-b4f9-c4a4ba55d062"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{
  3.9107608655809307`*^9, 3.941638653949205*^9, 3.9416919129971457`*^9, {
   3.97296839215971*^9, 3.972968417825708*^9}},
 CellLabel->"Out[77]=",ExpressionUUID->"d05a6bd6-4689-4692-bc49-473dfe6781aa"]
}, Open  ]],

Cell["\<\
\[OpenCurlyDoubleQuote]D\[CloseCurlyDoubleQuote] can also be used to compute \
things like the gradient (vector) or Hessian/Jacobian (matrix):\
\>", "Text",
 CellChangeTimes->{{3.9101684360900154`*^9, 
  3.910168459338787*^9}},ExpressionUUID->"8a7eccfc-a3fe-439f-9966-\
920025e943e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"x", " ", "y"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", "Gradient", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"x", " ", "y"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", "2"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Hessian", "/", "Jacobian"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "@", "%"}]}], "Input",
 CellChangeTimes->{{3.910168323284255*^9, 3.910168419977042*^9}, {
  3.910168461740887*^9, 3.9101684715434313`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"0253495f-f411-4450-93bb-3a9c6ad2d72a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"y", ",", "x"}], "}"}]], "Output",
 CellChangeTimes->{3.910760888113765*^9, 3.9416386642976522`*^9, 
  3.941691926753305*^9, 3.9729684266694937`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"987e6695-cd2f-4566-9aae-7c0858eee090"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
