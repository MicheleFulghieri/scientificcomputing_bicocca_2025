Cell[TextData[{
 "Q1: Find the first three roots of the Bessel function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["J", "1"], "(", "x", ")"}], "."}], TraditionalForm]],
  ExpressionUUID->"ee48d9e4-b245-4475-a79b-da464959a89a"],
