Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Sqrt", "[", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "2"]}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{"y", "->", "0"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"%", ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{"x", " ", "\[Element]", " ", "Reals"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", 
   RowBox[{"{", 
    RowBox[{"x", "->", "2"}], "}"}]}], "   "}], "\[IndentingNewLine]", 
 RowBox[{"%%", "/.", 
  RowBox[{"{", 
   RowBox[{"x", "->", 
    RowBox[{"-", "2"}]}], "}"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"substituting", " ", "x"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"2", " ", "o"}], " ", "-", "2"}]}], ",", " ", 
    RowBox[{"the", " ", "result", " ", "is", " ", "the", " ", 
     RowBox[{"same", ":", " ", 
      RowBox[{"it", " ", "is", " ", "my", " ", "fault"}]}]}], ",", " ", 
    RowBox[{
    "I", " ", "used", " ", "to", " ", "conflicting", " ", "assumptions"}]}], 
   " ", "*)"}]}]}], "Input",
