Cell["\<\
Here is another (simpler) example using the \[OpenCurlyDoubleQuote]WhenEvent\
\[CloseCurlyDoubleQuote] event locator function to simulate a bouncing ball. \
The syntax for \[OpenCurlyDoubleQuote]WhenEvent\[CloseCurlyDoubleQuote] is \
WhenEvent[event, action].\
\>", "Text",
 CellChangeTimes->{{3.910239236812088*^9, 3.9102392726880093`*^9}, {
  3.9102393263503733`*^9, 
  3.9102393373869514`*^9}},ExpressionUUID->"635cdaf6-0631-4015-94ee-\
a69af8eca22c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "t", "]"}], "==", 
       RowBox[{"-", "9.8"}]}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "5"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{"WhenEvent", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], "->", 
         RowBox[{
          RowBox[{"-", "0.9"}], 
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}]}]}]}], "]"}]}], "}"}], ",", 
    "y", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "ball", " ", "drop", " ", "under", " ", "gravity", " ", "without", " ", 
    "initial", " ", "velocity"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ynum", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y", "/.", 
      RowBox[{"Flatten", "@", "%"}]}], ")"}], "[", "t", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{"ynum", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"trajectory", ":", " ", 
    RowBox[{"bouncing", " ", "ball"}]}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.910238926715001*^9, 3.910239039248451*^9}, {
  3.9102390784275475`*^9, 3.9102391815699883`*^9}, {3.972969223480969*^9, 
  3.9729692685822773`*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"3c149da2-2d06-4cf0-ae92-92eac3a18ecf"],

