Cell[CellGroupData[{

Cell["Solving Systems of Algebraic Equations", "Section",
 CellChangeTimes->{{3.908957354593687*^9, 3.9089573594852114`*^9}, {
  3.9089574762894163`*^9, 
  3.908957484388813*^9}},ExpressionUUID->"21c794cb-959a-4760-acf6-\
995218c67552"],

Cell[CellGroupData[{

Cell["Solving Algebraic Equations", "Subsection",
 CellChangeTimes->{{3.9100678841655264`*^9, 3.9100678883530664`*^9}, {
  3.910067923242911*^9, 
  3.910067926308509*^9}},ExpressionUUID->"aeb41a66-f299-4fba-8492-\
3e726696ee46"],

Cell["\<\
The general function to solve algebraic equations is \
\[OpenCurlyDoubleQuote]Solve\[CloseCurlyDoubleQuote]. The output is always a \
list of substitution rules, ensuring that variables you use do not get \
overwritten. If more than one solution is found, you can take only one using \
[[n]] brackets.\
\>", "Text",
 CellChangeTimes->{{3.9100679101005917`*^9, 3.9100679341153655`*^9}, {
  3.9100679642653675`*^9, 3.910068030808121*^9}, {3.9416385172560253`*^9, 
  3.941638518072279*^9}},ExpressionUUID->"42e9be22-e115-4efc-8eb1-\
39d4bb018035"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "a", "]"}], "   "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", " ", "=", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        SuperscriptBox["x", "2"]}], "+", 
       RowBox[{"b", " ", "x"}], "+", "c"}], "==", "0"}], ",", "x"}], "]"}]}], 
  "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "solve", " ", "in", " ", "x", " ", "this", " ", "second", " ", "order", " ",
     "equation"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "/.", 
   RowBox[{"%", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "substitute", " ", "to", " ", "x", " ", "the", " ", "value", " ", "of", " ",
     "the", " ", "first", " ", "solution"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"x", "/.", 
     RowBox[{
      RowBox[{"Flatten", "@", "%%"}], "\[IndentingNewLine]", "x"}]}], "/.", 
    "%%%"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.910067935370137*^9, 3.910067948110468*^9}, {
   3.9100680329761686`*^9, 3.9100680553300433`*^9}, {3.9104112845555496`*^9, 
   3.9104112871668224`*^9}, {3.9104113391957874`*^9, 
   3.9104113520493507`*^9}, {3.91041143807609*^9, 3.9104114389862814`*^9}, 
   3.9107602249424133`*^9, {3.9416914320591784`*^9, 3.941691433188868*^9}, {
   3.9729679826579657`*^9, 3.972968026236568*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"ee8439e4-2196-41bf-b8e1-82f4068b0ffe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "b"}], "-", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["b", "2"], "-", 
         RowBox[{"4", " ", "a", " ", "c"}]}]]}], 
      RowBox[{"2", " ", "a"}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "b"}], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["b", "2"], "-", 
         RowBox[{"4", " ", "a", " ", "c"}]}]]}], 
      RowBox[{"2", " ", "a"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9107601059185266`*^9, 3.910760249737678*^9, 3.9416385192738867`*^9, 
   3.941691384361702*^9, 3.9416914334997*^9, {3.972968002925572*^9, 
   3.9729680296045103`*^9}},
 CellLabel->"Out[35]=",ExpressionUUID->"7a7be1d7-5144-4c12-89ac-8cefaf06a65c"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"-", "b"}], "-", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["b", "2"], "-", 
     RowBox[{"4", " ", "a", " ", "c"}]}]]}], 
  RowBox[{"2", " ", "a"}]]], "Output",
 CellChangeTimes->{
  3.9107601059185266`*^9, 3.910760249737678*^9, 3.9416385192738867`*^9, 
   3.941691384361702*^9, 3.9416914334997*^9, {3.972968002925572*^9, 
   3.972968029607541*^9}},
 CellLabel->"Out[36]=",ExpressionUUID->"e7adf99f-a722-4fec-ba78-f5f2bdac8fcf"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"x", "/.", 
  RowBox[{"sol", "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.941691435090055*^9, 3.941691451388298*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"c9421cc4-2bf9-40a4-bfff-9556fa156b7e"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"-", "b"}], "-", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["b", "2"], "-", 
     RowBox[{"4", " ", "a", " ", "c"}]}]]}], 
  RowBox[{"2", " ", "a"}]]], "Output",
 CellChangeTimes->{{3.941691436485818*^9, 3.941691453399961*^9}},
 CellLabel->
  "Out[163]=",ExpressionUUID->"15ffcaa2-f100-4b23-a636-89254a83b33b"]
}, Open  ]],

Cell["\<\
\[OpenCurlyDoubleQuote]Solve\[CloseCurlyDoubleQuote] also works with \
numerical coefficients, and can find complex solutions.\
\>", "Text",
 CellChangeTimes->{{3.9100680805917883`*^9, 
  3.9100681396952868`*^9}},ExpressionUUID->"83396421-b766-411c-9c47-\
7e6ee10f37a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"2", "x"}], "+", "1"}], "==", "0"}], ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "5"], "==", "1"}], ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ComplexExpand", "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "divide", " ", "the", " ", "result", " ", "in", " ", "real", " ", "and", " ",
     "imaginary", " ", "parts"}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.910068112714758*^9, 3.910068125064269*^9}, {
  3.910068217591397*^9, 3.9100682457555914`*^9}, {3.9729680464747562`*^9, 
  3.972968065308008*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"1bb25dda-9c94-4106-b0a8-c859fd4dae63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SqrtBox["3"]}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
