Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Graphical", " ", "inspection", " ", "in", " ", "order", " ", "to", " ", 
    "locate", " ", "the", " ", "domain", " ", "of", " ", "the", " ", "first", 
    " ", "three", " ", "roots"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"xmin", " ", "=", " ", "0"}], "\n", 
   RowBox[{"xmax", " ", "=", " ", "15"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"BesselJ", "[", 
      RowBox[{"1", ",", " ", "x"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"->", " ", 
      RowBox[{"by", " ", "graphical", " ", "inspection"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "I", " ", "can", " ", "solve", " ", "in", " ", "a", " ", "domain", " ", 
       "of", " ", "appox"}], " ", "-", 
      RowBox[{"1", "  ", "to", " ", "8"}]}]}], " ", "*)"}]}]}]], "Code",
