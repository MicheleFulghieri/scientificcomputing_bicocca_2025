  3.910761049111328*^9, 3.94163872865562*^9, 3.941692045299611*^9, {
   3.972968495509563*^9, 3.972968518296064*^9}},
 CellLabel->"Out[96]=",ExpressionUUID->"5fb559ff-4f9c-4c80-8ff4-15f981abd373"]
}, Open  ]],

Cell["\<\
You can also perform integration with respect to multiple variables with a \
single command. For example, here is an example of the orthogonality of \
spherical harmonics:\
\>", "Text",
 CellChangeTimes->{{3.910168993757821*^9, 3.9101690431498528`*^9}, {
  3.9101691212160163`*^9, 
  3.9101691244769373`*^9}},ExpressionUUID->"96f98ca5-494f-4436-ad5e-\
ac9599246df2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"SphericalHarmonicY", "[", 
      RowBox[{"2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
     RowBox[{"SphericalHarmonicY", "[", 
      RowBox[{"2", ",", 
       RowBox[{"-", "2"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "0", ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "verifying", " ", "that", " ", "AS", " ", "are", " ", "orthogonal"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SphericalHarmonicY", "[", 
     RowBox[{"2", ",", "2", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
    RowBox[{"SphericalHarmonicY", "[", 
     RowBox[{"2", ",", 
      RowBox[{"-", "1"}], ",", "\[Theta]", ",", "\[Phi]"}], "]"}], 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.910169044288416*^9, 3.9101691152563653`*^9}, {
  3.972968525098978*^9, 3.972968540888192*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"d0b39b3d-baff-4bbf-86b2-7960af5ac80e"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.910761067791745*^9, 3.941638739067705*^9, 
  3.941692061615305*^9, 3.972968541702013*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"3bb1935d-f7cd-43be-be8f-1e58e5a3ed78"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.910761067791745*^9, 3.941638739067705*^9, 
  3.941692061615305*^9, 3.972968542233322*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"127d699d-f401-45af-ac4c-71f41695e94d"]
}, Open  ]],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Integrate\[CloseCurlyDoubleQuote] is powerful and \
knows the results of many integral tables, for example\n",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    SubscriptBox["\[Integral]", "1"], "\[Infinity]"], 
   RowBox[{"dn", " ", 
    SuperscriptBox["n", 
     RowBox[{"-", "2"}]], 
    SubscriptBox["K", 
     RowBox[{"2", "/", "3"}]], 
    RowBox[{"(", 
     RowBox[{"n", " ", "z"}], ")"}], 
    SubscriptBox["K", 
     RowBox[{"1", "/", "3"}]], 
    RowBox[{"(", 
     RowBox[{"n", " ", "z"}], ")"}]}]}]],ExpressionUUID->
  "c7317fae-3eaa-4ab3-8d1e-c09617de3c8b"],
 " "
}], "Text",
 CellChangeTimes->{{3.910169182339116*^9, 3.910169195418559*^9}, {
  3.910169400478006*^9, 3.9101694457158546`*^9}, {3.910169495452714*^9, 
  3.910169498604373*^9}, {3.9729685475352697`*^9, 
  3.97296855261157*^9}},ExpressionUUID->"42492019-f47a-4988-89d9-\
33864427be35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["n", 
      RowBox[{"-", "2"}]], " ", 
     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{"2", "/", "3"}], ",", 
       RowBox[{"n", " ", "z"}]}], "]"}], " ", 
     RowBox[{"BesselK", "[", 
      RowBox[{
       RowBox[{"1", "/", "3"}], ",", 
       RowBox[{"n", " ", "z"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"z", ">", "0"}], "&&", 
       RowBox[{"z", "<", "1"}]}], "}"}]}]}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "complex", " ", "integral", " ", "of", " ", "bessel", " ", "functions"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9101691969156427`*^9, 3.910169255005838*^9}, {
  3.910169315099299*^9, 3.9101693883643*^9}, {3.972968554126769*^9, 
  3.9729685652426*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"2bdcd151-6134-42c9-9e3a-6468b11934bc"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"640", " ", 
    SqrtBox["3"], " ", "z"}]], 
  RowBox[{"\[Pi]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"1440", " ", 
        SqrtBox["\[Pi]"], " ", 
        SuperscriptBox["z", 
         RowBox[{"2", "/", "3"}]], " ", 
        RowBox[{"HypergeometricPFQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["2", "3"]}], ",", 
            FractionBox["5", "6"]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            FractionBox["1", "3"], ",", 
            FractionBox["2", "3"], ",", 
            FractionBox["4", "3"]}], "}"}], ",", 
          SuperscriptBox["z", "2"]}], "]"}]}], 
       RowBox[{"Gamma", "[", 
        FractionBox["1", "6"], "]"}]]}], "+", 
     FractionBox[
      RowBox[{"4320", " ", 
       SqrtBox["\[Pi]"], " ", 
       SuperscriptBox["z", 
        RowBox[{"4", "/", "3"}]], " ", 
       RowBox[{"HypergeometricPFQ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "3"]}], ",", 
           FractionBox["7", "6"]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["2", "3"], ",", 
           FractionBox["4", "3"], ",", 
           FractionBox["5", "3"]}], "}"}], ",", 
         SuperscriptBox["z", "2"]}], "]"}]}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"-", 
        FractionBox["1", "6"]}], "]"}]], "-", 
     RowBox[{"243", " ", 
      SuperscriptBox["z", "4"], " ", 
      RowBox[{"HypergeometricPFQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", 
          FractionBox["5", "2"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          FractionBox["7", "3"], ",", 
          FractionBox["8", "3"], ",", "3"}], "}"}], ",", 
        SuperscriptBox["z", "2"]}], "]"}]}], "-", 
     RowBox[{"40", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "8"}], "+", 
        RowBox[{"9", " ", 
         SuperscriptBox["z", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "7"}], "+", 
           RowBox[{"4", " ", "EulerGamma"}], "+", 
           RowBox[{"Log", "[", 
            FractionBox["729", "16"], "]"}]}], ")"}]}], "+", 
        RowBox[{"36", " ", 
         SuperscriptBox["z", "2"], " ", 
         RowBox[{"Log", "[", "z", "]"}]}]}], ")"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.910761125310996*^9, 3.941638752000984*^9, 
  3.9416920948340683`*^9, 3.97296857435312*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"1015ef5e-649f-4829-9a16-8db6a6ecace3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Series Expansions", "Subsection",
 CellChangeTimes->{{3.9101695224632893`*^9, 
  3.9101695244735184`*^9}},ExpressionUUID->"e6d33fcf-9099-40e0-a413-\
61940c11f04d"],

Cell["\<\
Suppose you have a function and want to study it\[CloseCurlyQuote]s local \
behavior around a point (i.e. you need to compute it\[CloseCurlyQuote]s \
Taylor expansion/series). Mathematica has a function for this called \
\[OpenCurlyDoubleQuote]Series\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.9101695662903123`*^9, 
  3.910169613728095*^9}},ExpressionUUID->"a81298bd-44ab-4b00-b025-\
daa716d0678a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "5"}], "}"}]}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "SST", " ", "of", " ", "senx", " ", "in", " ", "x", " ", "centerd", " ", 
    "in", " ", "0", " ", "since", " ", "order", " ", "5"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "mathematica", " ", "try", " ", "to", " ", "keep", " ", "track", " ", 
      "of", " ", "the", " ", "order", " ", "of", " ", "the", " ", "neglected",
       " ", 
      RowBox[{"term", ".", " ", "St"}], " ", "can", " ", "be", " ", "useful", 
      " ", "to", " ", "get", " ", "rid", " ", "of", " ", "this"}], " ", "->", 
     " ", 
     RowBox[{"normal", " ", "function"}]}], ",", " ", 
    RowBox[{"see", " ", "below"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9101696148159122`*^9, 3.9101696190780573`*^9}, {
  3.972968582328259*^9, 3.9729686758754463`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"4e6b9b9a-0f12-4c0c-a746-cf95f4bbbea7"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"x", "-", 
   FractionBox[
    SuperscriptBox["x", "3"], "6"], "+", 
   FractionBox[
    SuperscriptBox["x", "5"], "120"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "6"],
    SeriesData[$CellContext`x, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1, 0, 
    Rational[-1, 6], 0, 
    Rational[1, 120]}, 1, 6, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.910761171829459*^9, 3.941638767222229*^9, 3.941692125954405*^9, {
   3.972968578901181*^9, 3.9729686120979652`*^9}, {3.972968672940563*^9, 
   3.97296867624124*^9}},
 CellLabel->
  "Out[106]=",ExpressionUUID->"27719686-97f5-4108-a275-e24dc2be0fe9"]
}, Open  ]],

Cell["\<\
The first input is always the function you desire to series expand, while the \
second is an array {} with structure {var, pt, order}. \[OpenCurlyQuote]var\
\[CloseCurlyQuote] is the variable to series expand in, \[OpenCurlyQuote]pt\
\[CloseCurlyQuote] is the value of the variable to expands around, and \
\[OpenCurlyQuote]order\[CloseCurlyQuote] is the order of the expansion \
(highest power of \[OpenCurlyQuote]var\[CloseCurlyQuote] in the series).\
\>", "Text",
 CellChangeTimes->{{3.910169635638073*^9, 
  3.9101697032009106`*^9}},ExpressionUUID->"9de40430-5091-4b6e-b071-\
2fa8f00ea5d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "f", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "x0", ",", "2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9101697043479156`*^9, 3.910169716335267*^9}, {
  3.910169860144985*^9, 3.9101698634438114`*^9}, {3.9103370596005135`*^9, 
  3.9103370616033587`*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"e8893b5f-ca53-443b-a0fd-1ef3f84a7113"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"f", "[", "x0", "]"}], "+", 
   RowBox[{
    RowBox[{
     SuperscriptBox["f", "\[Prime]",
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "x0"}], ")"}]}], "+", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{
     SuperscriptBox["f", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x0", "]"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}], "2"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"x", "-", "x0"}], "]"}], "3"],
    SeriesData[$CellContext`x, $CellContext`x0, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, $CellContext`x0, {
    $CellContext`f[$CellContext`x0], 
    Derivative[1][$CellContext`f][$CellContext`x0], Rational[1, 2] 
    Derivative[2][$CellContext`f][$CellContext`x0]}, 0, 3, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.91076119069357*^9, 3.941638771489097*^9, 
  3.94169214398421*^9, 3.9729686176302443`*^9, 3.972968678397794*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"df12df7a-a224-443e-8c5d-bd960e747244"]
}, Open  ]],

Cell[TextData[{
 "The output always has the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "[", 
    SuperscriptBox["x", "n"], "]"}], TraditionalForm]],ExpressionUUID->
  "f011ce05-814d-46a7-b8c9-9647b44a315a"],
 " symbol at the end of it, which indicates the remainder of the series \
expansion. From a formal theory perspective, this is fine, but you may notice \
Mathematica will not want to simplify/manipulate an expressions with this \
symbol. To get rid of it, apply the \[OpenCurlyDoubleQuote]Normal\
\[CloseCurlyDoubleQuote] function."
}], "Text",
 CellChangeTimes->{{3.9101697682395935`*^9, 
  3.9101698473355374`*^9}},ExpressionUUID->"4615679c-fbec-4246-b3de-\
3d51e23694c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Normal", "@", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "x0", ",", "2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "x0", ",", "2"}], "}"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "x0", ",", "2"}], "}"}]}], "]"}], "//", 
  "Normal"}]}], "Input",
 CellChangeTimes->{{3.9101698492325687`*^9, 3.910169886190234*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"25fe6c36-655d-4334-9ba6-411a8ede8f30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x0", "]"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "x0"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "x0"}], ")"}], "2"], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}]}]], "Output",
 CellChangeTimes->{3.910761208175531*^9, 3.94163878262236*^9, 
  3.9416921785251207`*^9, 3.9729686820111723`*^9},
 CellLabel->
  "Out[109]=",ExpressionUUID->"6f1d6fca-4767-497d-9121-d51535c164d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x0", "]"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "x0"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "x0"}], ")"}], "2"], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}]}]], "Output",
 CellChangeTimes->{3.910761208175531*^9, 3.94163878262236*^9, 
  3.9416921785251207`*^9, 3.972968682016377*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"4d5d2328-5958-4262-977b-8481aba3ecd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x0", "]"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "x0"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "x0"}], ")"}], "2"], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "x0", "]"}]}]}]], "Output",
 CellChangeTimes->{3.910761208175531*^9, 3.94163878262236*^9, 
  3.9416921785251207`*^9, 3.972968682019947*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"b0e3c87a-2096-437a-bff5-0ed90229cfd9"]
}, Open  ]],

Cell["\[OpenCurlyDoubleQuote]Series\[CloseCurlyDoubleQuote] can be useful for \
taking limits:", "Text",
 CellChangeTimes->{{3.910169943901641*^9, 
  3.91016995119853*^9}},ExpressionUUID->"ee65af1f-4012-45a2-9577-\
47e76bb39c28"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "/", "x"}], "/.", 
   RowBox[{"{", 
    RowBox[{"x", "->", "0"}], "}"}]}], "   ", 
  RowBox[{"(*", "limits", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Limit", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"Sinn", "[", "x", "]"}], "/", "x"}], ",", " ", 
    RowBox[{"(", 
     RowBox[{"x", ",", "0", ",", "3"}], ")"}]}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.910169952823374*^9, 3.9101699678063974`*^9}, {
  3.910170554808398*^9, 3.9101705551552796`*^9}, {3.97296869006423*^9, 
  3.972968762123419*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"768aa403-65cc-49e0-bcdf-cc02af1843a4"],

Cell[BoxData[
 TemplateBox[{
  "Power", "infy", 
   "\"Infinite expression \\!\\(\\*FractionBox[\\\"1\\\", \\\"0\\\"]\\) \
encountered.\"", 2, 113, 5, 18036799314640540459, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.910761246644699*^9, 3.941638794513706*^9, 
  3.941692194509404*^9, 3.972968702726143*^9, 3.972968762918549*^9},
 CellLabel->
  "During evaluation of \
In[113]:=",ExpressionUUID->"574344ee-c305-4626-a695-b60ffa37989c"],

Cell[BoxData[
 TemplateBox[{
  "Infinity", "indet", 
   "\"Indeterminate expression \\!\\(\\*RowBox[{\\\"0\\\", \\\" \\\", \
\\\"ComplexInfinity\\\"}]\\) encountered.\"", 2, 113, 6, 18036799314640540459,
    "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.910761246644699*^9, 3.941638794513706*^9, 
  3.941692194509404*^9, 3.972968702726143*^9, 3.97296876292852*^9},
 CellLabel->
  "During evaluation of \
In[113]:=",ExpressionUUID->"25b387e9-7fc1-41f8-9ba3-4019379e7bab"],

Cell[BoxData["Indeterminate"], "Output",
 CellChangeTimes->{3.91076124671341*^9, 3.941638794606189*^9, 
  3.941692194608567*^9, 3.972968702745599*^9, 3.9729687629372787`*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"0a991a99-2fc2-4104-9434-852e1a893c8d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "/", "x"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Normal", "@", "%"}], "\[IndentingNewLine]", 
 RowBox[{"%", "/.", 
  RowBox[{"{", 
   RowBox[{"x", "->", "0"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.910169973331585*^9, 3.9101699949872913`*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"1a3f4205-57fc-4927-b3cb-6236b30cca68"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "-", 
   FractionBox[
    SuperscriptBox["x", "2"], "6"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "4"],
    SeriesData[$CellContext`x, 0, {}, 0, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {1, 0, 
    Rational[-1, 6]}, 0, 4, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.9107612767292423`*^9, {3.941638805767077*^9, 3.941638813644038*^9}, 
   3.941692209315716*^9},
 CellLabel->
  "Out[228]=",ExpressionUUID->"f36ea741-776d-40c9-a04f-4bb4dab06570"],

Cell[BoxData[
 RowBox[{"1", "-", 
  FractionBox[
   SuperscriptBox["x", "2"], "6"]}]], "Output",
 CellChangeTimes->{
  3.9107612767292423`*^9, {3.941638805767077*^9, 3.941638813644038*^9}, 
   3.9416922093768063`*^9},
 CellLabel->
  "Out[229]=",ExpressionUUID->"2cccaafc-d921-4037-ad34-434532d7662c"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{
  3.9107612767292423`*^9, {3.941638805767077*^9, 3.941638813644038*^9}, 
   3.9416922094105263`*^9},
 CellLabel->
  "Out[230]=",ExpressionUUID->"90258ca4-85a2-43cb-9a17-de8aeac5179f"]
}, Open  ]],

Cell[BoxData[""], "Input",
 CellChangeTimes->{
  3.91076128698328*^9},ExpressionUUID->"0726bb33-393c-4967-afeb-f40ab273ed05"],

Cell["Note, that \[OpenCurlyDoubleQuote]Series\[CloseCurlyDoubleQuote] can \
also compute asymptotic series:", "Text",
 CellChangeTimes->{{3.9101702783441925`*^9, 
  3.9101702924091053`*^9}},ExpressionUUID->"b5b4254d-a4dd-48f6-90d4-\
de3aecf84529"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "+", 
      SuperscriptBox["x", "2"]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "\[Infinity]", ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.91017029414445*^9, 3.910170303281002*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"1598bc16-f738-4f79-9bd2-ee88d407264c"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["1", "x"], "-", 
   FractionBox["1", 
    RowBox[{"2", " ", 
     SuperscriptBox["x", "3"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      FractionBox["1", "x"], "]"}], "4"],
    SeriesData[$CellContext`x, 
     DirectedInfinity[1], {}, 1, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 
   DirectedInfinity[1], {1, 0, 
    Rational[-1, 2]}, 1, 4, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.910761300539898*^9, 3.941638822578662*^9, 
  3.941692221684658*^9},
 CellLabel->
  "Out[231]=",ExpressionUUID->"49031e22-6d9d-46c1-bb1f-ea45449e044b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Numerical Integration", "Subsection",
 CellChangeTimes->{{3.9101707417965755`*^9, 
  3.9101707443842697`*^9}},ExpressionUUID->"9c32d2dd-d3d2-4afa-90af-\
3568924dac8e"],

Cell["\<\
We covered \[OpenCurlyDoubleQuote]Integrate\[CloseCurlyDoubleQuote] already, \
but sometimes you may encounter complicated integrals that don\
\[CloseCurlyQuote]t have analytic solutions.\
\>", "Text",
 CellChangeTimes->{{3.9101708832790737`*^9, 3.9101709059199295`*^9}, {
  3.9103372860685225`*^9, 
  3.9103372875945525`*^9}},ExpressionUUID->"344f4fc6-a836-40eb-8bbb-\
31f620d2e886"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "x"], 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"Log", "[", "x", "]"}], "/", "x"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.91017084596824*^9, 3.910170865448326*^9}, {
  3.941638826691153*^9, 3.9416388272801733`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"44a9d442-be7c-4862-b176-e672c242a79b"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "0", "1"], 
  RowBox[{
   FractionBox[
    RowBox[{"Cos", "[", 
     FractionBox[
      RowBox[{"Log", "[", "x", "]"}], "x"], "]"}], "x"], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Output",
 CellChangeTimes->{3.910761330107272*^9, 3.941638828467958*^9, 
  3.9416922413488913`*^9, 3.972968770891149*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"1c229501-24f0-4fcc-ab42-8281e9ee90a0"]
}, Open  ]],

Cell["\<\
For these, you can use numerical integration via \
\[OpenCurlyDoubleQuote]NIntegrate\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.9101709207486935`*^9, 
  3.9101709382389803`*^9}},ExpressionUUID->"5ec5af6c-9997-46ba-8333-\
1dea0e3b4840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "x"], 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"Log", "[", "x", "]"}], "/", "x"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9101709394698367`*^9, 3.9101709501530533`*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"66d7b073-315c-4b85-9444-0c0210e25933"],

Cell[BoxData["0.3233674295746727`"], "Output",
 CellChangeTimes->{3.910761346429535*^9, 3.941638830182725*^9, 
  3.941692258902465*^9, 3.972968775704686*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"cb894cd1-2a3f-4ba5-a1f7-08796a245794"]
}, Open  ]],

Cell["\<\
\[OpenCurlyDoubleQuote]NIntegrate\[CloseCurlyDoubleQuote] has much of the \
same functionality of \
\[OpenCurlyDoubleQuote]Integrate\[CloseCurlyDoubleQuote], it just gives you \
numerical answers instead of analytic ones (so you can\[CloseCurlyQuote]t use \
it for indefinite integrals, sorry). Here\[CloseCurlyQuote]s a really \
pedantic integral that has an exact answer we can compare to the numerical \
one:\
\>", "Text",
 CellChangeTimes->{{3.910170997152754*^9, 3.9101710485561194`*^9}, {
  3.9101711714765263`*^9, 
